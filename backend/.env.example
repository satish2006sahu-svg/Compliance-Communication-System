# ==============================================================================
# AI-POWERED REGULATORY COMPLIANCE SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Project & Security
PROJECT_NAME="AI-Powered Regulatory Compliance Communication System"
SECRET_KEY="replace-with-a-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./compliance.db"

# ------------------------------------------------------------------------------
# 1. Firecrawl API Configuration (compulsory for regulatory website scraping)
# Obtain your API key from: https://firecrawl.dev
# ------------------------------------------------------------------------------
FIRECRAWL_API_KEY=""
FIRECRAWL_BASE_URL="https://api.firecrawl.dev"

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration (compulsory for regulatory analysis, announcements, FAQs, and chatbot)
# Choose "gemini" or "openai"
# ------------------------------------------------------------------------------
LLM_PROVIDER="gemini"

# Option A: Google Gemini API (Recommended, fast & free tier available)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Option B: OpenAI API (or compatible e.g. Groq, Together, Ollama)
# Obtain from: https://platform.openai.com/
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 3. Memento Persistent Memory Configuration (compulsory for employee chatbot)
# Enforces isolated per-employee bitemporal memory graphs
# ------------------------------------------------------------------------------
MEMENTO_STORAGE_DIR="./data/memento"
MEMENTO_EMBEDDING_PROVIDER="deterministic"  # "deterministic" (zero extra install) or "openai"
