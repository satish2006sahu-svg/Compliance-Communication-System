# ==============================================================================
# ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to backend/.env and configure your API keys
# ==============================================================================

# Security
SECRET_KEY="replace-with-a-random-32-byte-hex-string-for-production"

# Firecrawl API (https://firecrawl.dev)
FIRECRAWL_API_KEY=""

# LLM Provider ("gemini" or "openai")
LLM_PROVIDER="gemini"

# Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# OpenAI API (https://platform.openai.com/)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Memento Persistent Memory
MEMENTO_STORAGE_DIR="./data/memento"
MEMENTO_EMBEDDING_PROVIDER="deterministic"
